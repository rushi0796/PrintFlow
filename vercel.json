{
  "rewrites": [
    {
      "source": "/customer",
      "destination": "/login.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/create-razorpay-order",
      "destination": "/api/create-order.py"
    },
    {
      "source": "/api/create-razorpay-order",
      "destination": "/api/create-order.py"
    },
    {
      "source": "/create-order",
      "destination": "/api/create-order.py"
    },
    {
      "source": "/verify-razorpay-payment",
      "destination": "/api/verify-payment.py"
    },
    {
      "source": "/api/verify-razorpay-payment",
      "destination": "/api/verify-payment.py"
    },
    {
      "source": "/verify-payment",
      "destination": "/api/verify-payment.py"
    },
    {
      "source": "/api/agent/status",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/agent/poll",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/agent/claim/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/agent/complete/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/orders/(.*)/retry",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/agent/test-print",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 30
    }
  }
}
